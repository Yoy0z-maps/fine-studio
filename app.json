{
  "expo": {
    "name": "fine-tune",
    "slug": "fine-tune",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finetune",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "ko", "ja", "zh"],
            "android": ["en", "ko", "ja", "zh"]
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/pretendard/Pretendard-Thin.ttf",
            "./assets/fonts/pretendard/Pretendard-Light.ttf",
            "./assets/fonts/pretendard/Pretendard-Regular.ttf",
            "./assets/fonts/pretendard/Pretendard-Medium.ttf",
            "./assets/fonts/pretendard/Pretendard-SemiBold.ttf",
            "./assets/fonts/pretendard/Pretendard-Bold.ttf",

            "./assets/fonts/pretendardJP/PretendardJP-Thin.ttf",
            "./assets/fonts/pretendardJP/PretendardJP-Light.ttf",
            "./assets/fonts/pretendardJP/PretendardJP-Regular.ttf",
            "./assets/fonts/pretendardJP/PretendardJP-Medium.ttf",
            "./assets/fonts/pretendardJP/PretendardJP-SemiBold.ttf",
            "./assets/fonts/pretendardJP/PretendardJP-Bold.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-Thin.ttf",
                    "weight": 100
                  },
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/pretendard/Pretendard-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "PretendardJP",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/pretendardJP/PretendardJP-Thin.ttf",
                    "weight": 100
                  },
                  {
                    "path": "./assets/fonts/pretendardJP/PretendardJP-Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "./assets/fonts/pretendardJP/PretendardJP-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/pretendardJP/PretendardJP-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/pretendardJP/PretendardJP-SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/pretendardJP/PretendardJP-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/pretendard/Pretendard-Thin.ttf",
              "./assets/fonts/pretendard/Pretendard-Light.ttf",
              "./assets/fonts/pretendard/Pretendard-Regular.ttf",
              "./assets/fonts/pretendard/Pretendard-Medium.ttf",
              "./assets/fonts/pretendard/Pretendard-SemiBold.ttf",
              "./assets/fonts/pretendard/Pretendard-Bold.ttf",

              "./assets/fonts/pretendardJP/PretendardJP-Thin.ttf",
              "./assets/fonts/pretendardJP/PretendardJP-Light.ttf",
              "./assets/fonts/pretendardJP/PretendardJP-Regular.ttf",
              "./assets/fonts/pretendardJP/PretendardJP-Medium.ttf",
              "./assets/fonts/pretendardJP/PretendardJP-SemiBold.ttf",
              "./assets/fonts/pretendardJP/PretendardJP-Bold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
